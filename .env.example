# I'm Dead — backend env. Copy to .env.local and fill in.
# The backend needs two keys:

# AssemblyAI: voice clone (AssemblyAI-TTS-1). Account must have accepted the
# biometric data terms (dashboard -> data controls) and have a positive balance.
ASSEMBLYAI_API_KEY=

# Google Gemini: ghost image transform (gemini-2.5-flash-image).
GOOGLE_API_KEY=

# Optional overrides:
# PORT=5001                                  # Flask port
# DATA_DIR=./data                            # per-session storage root
# ASSEMBLYAI_TTS_HOST=https://tts.us.assemblyai.com   # data-zone host
